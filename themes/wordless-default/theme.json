{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "customTemplates": [],
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "color": "#FFFFFF",
          "name": "Base",
          "slug": "base"
        },
        {
          "color": "#122019",
          "name": "Contrast",
          "slug": "contrast"
        },
        {
          "color": "#0D9488",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#64748B",
          "name": "Secondary",
          "slug": "secondary"
        },
        {
          "color": "#0F766E",
          "name": "Accent",
          "slug": "accent"
        },
        {
          "color": "#43584F",
          "name": "Muted",
          "slug": "muted"
        },
        {
          "color": "#F8FAFC",
          "name": "Surface",
          "slug": "surface"
        }
      ]
    },
    "custom": {
      "radius": "12px"
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1140px"
    },
    "spacing": {
      "spacingSizes": [
        {
          "name": "Tiny",
          "size": "10px",
          "slug": "20"
        },
        {
          "name": "X-Small",
          "size": "20px",
          "slug": "30"
        },
        {
          "name": "Small",
          "size": "30px",
          "slug": "40"
        },
        {
          "name": "Regular",
          "size": "clamp(30px, 5vw, 50px)",
          "slug": "50"
        },
        {
          "name": "Large",
          "size": "clamp(40px, 7vw, 70px)",
          "slug": "60"
        }
      ],
      "units": [
        "%",
        "px",
        "em",
        "rem"
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "name": "Base",
          "slug": "base"
        },
        {
          "fontFamily": "Georgia, \"Times New Roman\", serif",
          "name": "Serif",
          "slug": "serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "max": "1.375rem",
            "min": "1.125rem"
          },
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "fluid": {
            "max": "2rem",
            "min": "1.375rem"
          },
          "name": "X-Large",
          "size": "1.625rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "max": "2.75rem",
            "min": "1.75rem"
          },
          "name": "XX-Large",
          "size": "2.25rem",
          "slug": "xx-large"
        },
        {
          "fluid": {
            "max": "3.5rem",
            "min": "2.25rem"
          },
          "name": "Display",
          "size": "3rem",
          "slug": "display"
        }
      ]
    }
  },
  "styles": {
    "blocks": {
      "core/post-title": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.15"
        }
      },
      "core/quote": {
        "color": {
          "text": "var:preset|color|secondary"
        }
      }
    },
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|base"
        },
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        }
      }
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|base",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.7"
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    }
  ],
  "version": 3
}
